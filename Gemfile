source "https://rubygems.org"

# Mirrors the GitHub Pages build environment so that `bundle exec jekyll serve`
# renders the site the same way it renders once deployed. GitHub Pages ignores
# this file when it builds; it exists only for local previewing.
gem "github-pages", group: :jekyll_plugins

# Default gems removed from Ruby 3.4 that Jekyll's dependencies still expect.
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
